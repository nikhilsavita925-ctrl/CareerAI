# Copy this file to .env and fill in your LOCAL values.
SECRET_KEY=change-this-to-a-random-secret

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=internship_ai
MYSQL_PORT=3306

# Sender account only. OTPs can be sent to ANY user's email address.
# For Gmail, use a Google App Password (not your normal Gmail password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_sender_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
OTP_EXPIRY_MINUTES=10
